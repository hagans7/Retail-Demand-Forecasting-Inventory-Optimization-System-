# ── Development Environment Template ──────────────────────────────────────────
# Copy to .env.dev and fill in values. .env.dev is gitignored (never commit).
# Business rules (safety factors, decision weights) are managed via
# PATCH /config/business-rules API — NOT here.

LOG_ENV=dev
DEBUG=true

# Database
POSTGRES_DB=retail_decision_dev
POSTGRES_USER=platform_user
POSTGRES_PASSWORD=your_dev_password_here
DATABASE_URL=postgresql+asyncpg://platform_user:your_dev_password_here@postgres:5432/retail_decision_dev

# Redis
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# MinIO
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=your_minio_password_here
MINIO_ENDPOINT=minio:9000
MINIO_SECURE=false
MODEL_STORE_BUCKET=ml-models
