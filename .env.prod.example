# ── PRODUCTION ENVIRONMENT TEMPLATE ────────────────────────────────────────────
# Copy to .env.prod and fill in real values. NEVER commit .env.prod to git.
# Business rules are managed via /config/business-rules API, NOT here.

LOG_ENV=prod
DEBUG=false

POSTGRES_DB=retail_decision_prod
POSTGRES_USER=platform_user
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD

DATABASE_URL=postgresql+asyncpg://platform_user:CHANGE_ME@your-postgres-host:5432/retail_decision_prod

REDIS_URL=redis://your-redis-host:6379/0
CELERY_BROKER_URL=redis://your-redis-host:6379/1
CELERY_RESULT_BACKEND=redis://your-redis-host:6379/2

MINIO_ROOT_USER=CHANGE_ME
MINIO_ROOT_PASSWORD=CHANGE_ME_STRONG_PASSWORD
MINIO_ENDPOINT=your-minio-host:9000
MINIO_SECURE=true
MODEL_STORE_BUCKET=ml-models
